{
  "name": "manufacturing-erp-poc",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "dev:web": "vite",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply manufacturing-erp-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply manufacturing-erp-db --remote",
    "db:seed": "curl -s -X POST http://localhost:8787/api/dev/seed",
    "deploy:api": "wrangler deploy",
    "deploy:web": "vite build && wrangler pages deploy dist --project-name manufacturing-erp-web",
    "test": "vitest run"
  },
  "dependencies": {
    "drizzle-orm": "^0.38.0",
    "hono": "^4.6.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261006.1",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "drizzle-kit": "^0.30.0",
    "typescript": "^5.6.0",
    "vite": "^6.0.0",
    "vitest": "^2.1.0",
    "wrangler": "^4.0.0"
  }
}
